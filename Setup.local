*static*

# --- Modules required for Ren'Py / pygame_sdl2 on Switch ---
# Note: in CPython 3.12 the always-on built-in modules (posix, errno,
# _io, _sre, _codecs, _collections, _operator, itertools, time,
# _weakref, _functools, _locale, _symtable, _abc, _stat, _typing,
# atexit, faulthandler, _signal, _tracemalloc, _thread) live in
# Modules/Setup.bootstrap and must NOT be repeated here.

# pygame_sdl2 deps:
binascii binascii.c
_struct _struct.c
math mathmodule.c

# Ren'Py deps:
_pickle _pickle.c
_random _randommodule.c
_datetime _datetimemodule.c
zlib zlibmodule.c -I$(prefix)/include -L$(exec_prefix)/lib -lz
array arraymodule.c

# hashlib backend (3.12 uses the HACL* implementations):
_md5 md5module.c -I$(srcdir)/Modules/_hacl/include _hacl/Hacl_Hash_MD5.c -D_BSD_SOURCE -D_DEFAULT_SOURCE
_sha1 sha1module.c -I$(srcdir)/Modules/_hacl/include _hacl/Hacl_Hash_SHA1.c -D_BSD_SOURCE -D_DEFAULT_SOURCE
_sha2 sha2module.c -I$(srcdir)/Modules/_hacl/include Modules/_hacl/libHacl_Hash_SHA2.a
_sha3 sha3module.c -I$(srcdir)/Modules/_hacl/include _hacl/Hacl_Hash_SHA3.c -D_BSD_SOURCE -D_DEFAULT_SOURCE
_blake2 _blake2/blake2module.c _blake2/blake2b_impl.c _blake2/blake2s_impl.c

# Extra modules used by Ren'Py / stdlib:
_bisect _bisectmodule.c        # Bisection algorithms
_heapq _heapqmodule.c          # Heap queue algorithm
_json _json.c                  # _json speedups
_csv _csv.c                    # CSV file helper
_contextvars _contextvarsmodule.c  # Context Variables
_zoneinfo _zoneinfo.c          # zoneinfo accelerator
_statistics _statisticsmodule.c # statistics accelerator
_elementtree -I$(srcdir)/Modules/expat -DHAVE_EXPAT_CONFIG_H -DUSE_PYEXPAT_CAPI _elementtree.c  # elementtree accelerator
unicodedata unicodedata.c      # static Unicode character database
cmath cmathmodule.c            # complex math library functions
xxsubtype xxsubtype.c          # for profiling subclasses
_lsprof _lsprof.c rotatingtree.c

# CJK codecs:
_codecs_cn cjkcodecs/_codecs_cn.c
_codecs_hk cjkcodecs/_codecs_hk.c
_codecs_iso2022 cjkcodecs/_codecs_iso2022.c
_codecs_jp cjkcodecs/_codecs_jp.c
_codecs_kr cjkcodecs/_codecs_kr.c
_codecs_tw cjkcodecs/_codecs_tw.c
_multibytecodec cjkcodecs/multibytecodec.c

audioop audioop.c

# The following will not build on Switch, but are noted for reference:
# _ctypes _ctypes/_ctypes.c _ctypes/callbacks.c _ctypes/callproc.c _ctypes/stgdict.c _ctypes/cfield.c -lffi
# _hashlib _hashopenssl.c -lssl -lcrypto
# _ssl _ssl.c -lssl -lcrypto
# grp grpmodule.c        # disabled via configure (py_cv_module_grp=n/a)
# mmap mmapmodule.c
# pwd pwdmodule.c         # disabled via configure (py_cv_module_pwd=n/a)
# resource resource.c     # disabled via configure
# select selectmodule.c
# termios termios.c       # disabled via configure
# fcntl fcntlmodule.c     # disabled via configure
# _socket socketmodule.c
# _posixsubprocess _posixsubprocess.c  # disabled via configure
# _posixshmem             # disabled via configure
# syslog syslogmodule.c   # disabled via configure

# The following has linker issues when built statically on Switch:
# pyexpat expat/xmlparse.c expat/xmlrole.c expat/xmltok.c pyexpat.c -I$(srcdir)/Modules/expat -DHAVE_EXPAT_CONFIG_H -DUSE_PYEXPAT_CAPI
